# Copy file ini ke .env dan isi jika dibutuhkan (opsional)
# File .env sudah diabaikan oleh .gitignore

# === Google OAuth 2.0 ===
# Jika tidak ingin upload client_secret.json via UI, Anda bisa menaruh
# isi file JSON di sini sebagai string (tidak direkomendasikan untuk produksi).
GOOGLE_CLIENT_SECRET_JSON=

# === Streamlit Cloud ===
# Di Streamlit Cloud gunakan Secrets management, bukan .env
# https://docs.streamlit.io/streamlit-community-cloud/deploy-your-app/secrets-management
